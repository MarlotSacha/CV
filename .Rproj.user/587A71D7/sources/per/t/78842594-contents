traj = function(M,nsimul){
  trajectoire = c(NULL)
  position = sample(c(1,2,3,4,5,6),1)
  trajectoire = c(trajectoire,position)
  
  for(n in 1:nsimul){
    
    position = sample(c(1,2,3,4,5,6), prob = M[position,], size = 1)
    trajectoire = c(trajectoire,position)
  }
  
  return(trajectoire)
}

